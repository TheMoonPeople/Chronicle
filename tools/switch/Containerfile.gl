# The Nintendo Switch homebrew toolchain for Chronicle's GL renderer (docs/SWITCH.md, the switch-gl
# preset): devkitPro's devkitA64 and libnx with its packaged Mesa (nouveau GL and EGL, switch-mesa),
# and SDL3 from devkitPro's own switch-sdl-3.4 branch, which devkitPro does not package yet. SDL3
# opens its windows through that Mesa's EGL; the renderer loads GL through SDL.
#
# Kazarov's build still compiles its Vulkan shaders and includes the Vulkan headers for the context
# the display lists share, so glslang and the headers are here too; nothing links Vulkan.
#
# Built by tools/switch/build.sh (SWITCH_PRESET=switch-gl); podman or docker.

FROM docker.io/devkitpro/devkita64@sha256:1fc388c3a0d34bd2045a6dadcb1020e069d5f876a187fd705de14b4440c00282

ARG SDL_REV=c329016c0e338ab4397ad930f83330c9fe058348
ARG GLSLANG_TAG=16.6.0
ARG VULKAN_HEADERS_TAG=vulkan-sdk-1.4.363.0

ENV DEVKITPRO=/opt/devkitpro
ENV DEVKITA64=/opt/devkitpro/devkitA64
ENV SWITCH_PREFIX=/opt/switch
ENV PATH=/opt/devkitpro/devkitA64/bin:/opt/devkitpro/tools/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git ninja-build pkg-config build-essential cmake python3 \
    && rm -rf /var/lib/apt/lists/*

# Kazarov compiles its shaders with --target-env vulkan1.4, which Debian's glslang (12) predates.
RUN git clone --depth 1 --branch ${GLSLANG_TAG} https://github.com/KhronosGroup/glslang.git /tmp/glslang \
    && cmake -S /tmp/glslang -B /tmp/glslang/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_OPT=OFF -DGLSLANG_TESTS=OFF -DBUILD_SHARED_LIBS=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/glslang/build --target install \
    && rm -rf /tmp/glslang

RUN git clone --depth 1 --branch ${VULKAN_HEADERS_TAG} https://github.com/KhronosGroup/Vulkan-Headers.git /tmp/vulkan-headers \
    && mkdir -p ${SWITCH_PREFIX}/include \
    && cp -r /tmp/vulkan-headers/include/vulkan /tmp/vulkan-headers/include/vk_video ${SWITCH_PREFIX}/include/ \
    && rm -rf /tmp/vulkan-headers

RUN git clone https://github.com/devkitPro/SDL.git /tmp/sdl \
    && git -C /tmp/sdl checkout --detach ${SDL_REV} \
    && cmake -S /tmp/sdl -B /tmp/sdl/build -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE=${DEVKITPRO}/cmake/Switch.cmake -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=${SWITCH_PREFIX} \
        -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF -DSDL_VULKAN=OFF \
    && cmake --build /tmp/sdl/build --target install \
    && rm -rf /tmp/sdl

# The build runs as the invoking user (podman --userns=keep-id, or docker --user).
RUN chmod -R a+rX ${SWITCH_PREFIX}
