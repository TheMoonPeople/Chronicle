        ALIGNALL(1); // Perform no additional alignment
        . = ALIGN(0x80);
        // @ORDER vutext.cpp.o 0x0024b900   data only: the VU1 microprograms
        vutext.cpp.o (.vutext)                // 0x0024b900

        # data
        //
        // Retail's .data is one run per translation unit, in the order the
        // units link; every unit supplies its own. The library objects come
        // first; crt0 carries the 0x40 bytes in front of the first datum.
        crt0.s.o                     (.data)   // 0x002560c0
        impure.c.o                   (.data)   // 0x00256100
        locale.c.o                   (.data)   // 0x002563f0
