MEMORY
{
    main (RWX)  : ORIGIN = 0x00100000, LENGTH = 0
    // `> name` sends a region to its own overlay file; MWLD takes a bare
    // filename and writes it beside the -o output, i.e. into build/. Both
    // overlays load at the same explicit address -- the end of main's .bss.
    // AFTER(main) would say the same thing, but only once .main has been laid
    // out, and these regions have to be placed before it (see below).
    title (RWXO) : ORIGIN = 0x01DABD00, LENGTH = 0 > TITLE.BIN
    dun (RWXO)   : ORIGIN = 0x01DABD00, LENGTH = 0 > DUN.BIN
    heap (RW)   : ORIGIN = AFTER(main, title, dun), LENGTH = 0
}

SECTIONS
{
    // Overlays, written to their own files by the MEMORY block above. Each
    // @OVERLAY marker expands to that overlay's 64-byte MWo3 header, which
    // tools/kazarov/cmake/KazarovOverlays.cmake writes; it also explains why the overlays' objects
    // carry privately-prefixed section names.
    //
    // These come before .main only because MWLD assigns sections in the order
    // written here and .main ends with catch-all wildcards; the addresses come
    // from the MEMORY regions, not from this position.
    .title:
    {
        // @OVERLAY title
        // Retail's first function stands on a 128-byte boundary, which leaves
        // sixty-four bytes of nothing between the header and the overlay's own
        // code.
        . = ALIGN(128);
        script.cpp.o      (.ttext)   // 0x01dabd80
        dispfade.cpp.o    (.ttext)   // 0x01dad1e0
        bombeffect.cpp.o  (.ttext)   // 0x01dad610
        majinbeem.cpp.o   (.ttext)   // 0x01dadd50
        seireiking.cpp.o  (.ttext)   // 0x01dae590
        opening.cpp.o     (.ttext)   // 0x01daf1c0
        op_a.cpp.o        (.ttext)   // 0x01db4ec0
        op_b.cpp.o        (.ttext)   // 0x01db87d0
        op_c.cpp.o        (.ttext)   // 0x01dbba90
        op_d.cpp.o        (.ttext)   // 0x01dc3c90
        rushmovi.cpp.o    (.ttext)   // 0x01dc8930
        title.cpp.o       (.ttext)   // 0x01dcb2b0
        titleloop.cpp.o   (.ttext)   // 0x01dd1ab0
        logo.cpp.o        (.ttext)   // 0x01dd3e00
        sprite.cpp.o      (.ttext)   // 0x01dd4420
        cursol.cpp.o      (.ttext)   // 0x01dd4cc0
        scfader.cpp.o     (.ttext)   // 0x01dd5100
        tisound.cpp.o     (.ttext)   // 0x01dd5240
        *(.ttext)

        // The overlay's data starts on the segment alignment, not the
        // sixteen bytes a function needs.
        . = ALIGN(128);
        _title_data = .;

        // Each datum takes the slot its own object asks for rather than the
        // sixteen bytes MWLD would give it. Retail collects initialized data
        // from every unit before collecting their constants.
        ALIGNALL(1);
        script.cpp.o      (.tdata)
        dispfade.cpp.o    (.tdata)
        bombeffect.cpp.o  (.tdata)
        majinbeem.cpp.o   (.tdata)
        seireiking.cpp.o  (.tdata)
        opening.cpp.o     (.tdata)
        op_a.cpp.o        (.tdata)
        op_b.cpp.o        (.tdata)
        op_c.cpp.o        (.tdata)
        op_d.cpp.o        (.tdata)
        rushmovi.cpp.o    (.tdata)
        title.cpp.o       (.tdata)
        titleloop.cpp.o       (.tdata)
        logo.cpp.o        (.tdata)
        sprite.cpp.o      (.tdata)
        cursol.cpp.o      (.tdata)
        scfader.cpp.o     (.tdata)
        tisound.cpp.o     (.tdata)

        // Retail starts the constants on the segment alignment, the way it
        // starts the data and the static initialisers.
        . = ALIGN(128);
        script.cpp.o      (.trodata)   // 0x01ddbd80
        dispfade.cpp.o    (.trodata)
        bombeffect.cpp.o  (.trodata)
        majinbeem.cpp.o   (.trodata)
        seireiking.cpp.o  (.trodata)
        opening.cpp.o     (.trodata)
        op_a.cpp.o        (.trodata)
        op_b.cpp.o        (.trodata)
        op_c.cpp.o        (.trodata)
        op_d.cpp.o        (.trodata)
        rushmovi.cpp.o    (.trodata)
        title.cpp.o       (.trodata)
        titleloop.cpp.o     (.trodata)
        logo.cpp.o        (.trodata)
        sprite.cpp.o      (.trodata)
        cursol.cpp.o      (.trodata)
        scfader.cpp.o     (.trodata)
        tisound.cpp.o     (.trodata)

        // The overlay's static initialisers and the table that calls them.
        // Retail starts them on the segment alignment rather than the sixteen
        // bytes a function needs: its last constant ends at 0x01de0f16.
        . = ALIGN(128);
        *(.tinit)                         // 0x01de0f80
        . = ALIGN(16);
        _title_static_init = .;           // 0x01de1ae0
        *(.tctor)
        _title_static_init_end = .;       // 0x01de1afc

        *(.tdata)
        *(.trodata)

        ALIGNALL(1);
        _title_bss = .;
        script.cpp.o      (.tbss)
        dispfade.cpp.o    (.tbss)
        bombeffect.cpp.o  (.tbss)
        majinbeem.cpp.o   (.tbss)
        seireiking.cpp.o  (.tbss)
        opening.cpp.o     (.tbss)
        op_a.cpp.o        (.tbss)
        op_b.cpp.o        (.tbss)
        op_c.cpp.o        (.tbss)
        op_d.cpp.o        (.tbss)
        rushmovi.cpp.o    (.tbss)
        title.cpp.o       (.tbss)
        titleloop.cpp.o        (.tbss)
        logo.cpp.o        (.tbss)
        sprite.cpp.o      (.tbss)
        cursol.cpp.o      (.tbss)
        scfader.cpp.o     (.tbss)
        tisound.cpp.o     (.tbss)
        *(.tbss)
        _title_end = .;
    } > title

    .dun:
    {
        // @OVERLAY dun
        // As in the title overlay, the first function stands on a 128-byte
        // boundary, sixty-four bytes of nothing after the header; retail names
        // their start.
        _dun_text_start = .;
        . = ALIGN(128);
        gameloop.cpp.o  (.dtext)   // 0x01dabd80
        *(.dtext)

        // Retail leaves 128 bytes of nops between the overlay's last function
        // and its data, which starts on a 256-byte boundary.
        . = ALIGN(256);
        _dun_data = .;
        ALIGNALL(1);

        gameloop.cpp.o     (.ddata)     // 0x01dc1b00
        . = ALIGN(128);
        gameloop.cpp.o     (.drodata)   // 0x01dc2980
        // Retail's last constant ends twenty bytes short of the static
        // initialiser, which stands on a 32-byte boundary.
        . = ALIGN(32);
        gameloop.cpp.o     (.dinit)     // 0x01dc3580 __sinit_gameloop.cpp
        . = ALIGN(16);
        _dun_static_init = .;           // 0x01dc4410
        gameloop.cpp.o     (.dctor)
        _dun_static_init_end = .;
        *(.ddata)
        *(.drodata)

        ALIGNALL(1);
        _dun_bss = .;
        . = ALIGN(128);
        gameloop.cpp.o     (.dbss)      // 0x01dc4480
        *(.dbss)
        . = ALIGN(16);
        _dun_end = .;
    } > dun

    // main
    .main:
    {
        # Initial text alignment
        . = ALIGN(128);

        // Every translation unit, at the retail address written beside it. A
        // unit runs until the next one starts, so these partition the image
        // with no gaps. scripts/build/layout.py reads the lines below -- the
        // object name and the address both -- to write the link order, so the
        // trailing comments are part of the file rather than decoration.
        //
        // Retail's objects sit end to end with no padding anywhere in .text
        // and each starts on an 8-byte boundary, so one alignment covers them
        // all. The wildcard takes anything not named here.
        ALIGNALL(8);
        crt0.s.o                    (.text)   // 0x00100000
        // @ORDER impure.c.o 0x001001a8   newlib's impure.c: data only
        abort.c.o                   (.text)   // 0x001001a8
        abs.c.o                     (.text)   // 0x001001c8
        assert.c.o                  (.text)   // 0x001001e0
        atof.c.o                    (.text)   // 0x00100218
        atoi.c.o                    (.text)   // 0x00100238
        callocr.c.o                 (.text)   // 0x00100260
        closer.c.o                  (.text)   // 0x00100320
        dtoa.c.o                    (.text)   // 0x00100378
        errno.c.o                   (.text)   // 0x00101760
        exit.c.o                    (.text)   // 0x00101770
        fflush.c.o                  (.text)   // 0x00101820
        findfp.c.o                  (.text)   // 0x00101928
        fiprintf.c.o                (.text)   // 0x00101b80
        fprintf.c.o                 (.text)   // 0x00101bb8
        freer.c.o                   (.text)   // 0x00101bf0
        fstatr.c.o                  (.text)   // 0x00102080
        fvwrite.c.o                 (.text)   // 0x001020e0
        fwalk.c.o                   (.text)   // 0x001024b8
        locale.c.o                  (.text)   // 0x00102550
        lseekr.c.o                  (.text)   // 0x00102640
