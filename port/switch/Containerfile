# The Nintendo Switch homebrew toolchain for Chronicle (docs/SWITCH.md): devkitPro's devkitA64 and
# libnx, with the two libraries devkitPro does not package yet built in from source:
#
# - Mesa with NVK (Vulkan 1.3 on the Tegra X1) and nouveau GL/EGL, from etonedemid/mesa-switch.
#   Kazarov's Vulkan renderer runs on it unchanged.
# - SDL3 for libnx: devkitPro's switch-sdl-3.4 branch with etonedemid's Vulkan surface support
#   (VK_NN_vi_surface), from etonedemid/SDL.
#
# Both are installed under /opt/switch, ahead of devkitPro's portlibs (whose Mesa is 20.1).
# Built by port/switch/build.sh with Docker or another OCI-compatible runtime.

FROM docker.io/devkitpro/devkita64@sha256:1fc388c3a0d34bd2045a6dadcb1020e069d5f876a187fd705de14b4440c00282

ARG MESA_REV=e1e2a5ffa473312bec8e6d618f8c2ef269137ec9
ARG SDL_REV=1e3b67ef787c0fdba47b42fc663c70613c8b04db
ARG RUST_NIGHTLY=nightly-2026-09-20
ARG BINDGEN_VERSION=0.72.1
ARG MESON_VERSION=1.12.1
ARG GLSLANG_TAG=16.6.0

ENV DEVKITPRO=/opt/devkitpro
ENV DEVKITA64=/opt/devkitpro/devkitA64
ENV SWITCH_PREFIX=/opt/switch
ENV RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo
ENV PATH=/opt/rust/cargo/bin:/opt/devkitpro/devkitA64/bin:/opt/devkitpro/tools/bin:$PATH

# Mesa's host shader compiler (mesa_clc) needs LLVM with clang, libclc and SPIRV-LLVM-Translator;
# Debian 12 has all three at 15, which Mesa 26 accepts. Its Meson (1.0) is too old for Mesa 26.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git ninja-build pkg-config flex bison python3-pip python3-venv \
        python3-mako python3-yaml python3-packaging python3-ply \
        llvm-15-dev clang-15 libclang-15-dev libclc-15-dev libclc-15 llvm-spirv-15 libllvmspirvlib-15-dev \
        build-essential cmake \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --no-cache-dir meson==${MESON_VERSION} \
    && ln -sf /usr/bin/llvm-config-15 /usr/local/bin/llvm-config \
    && ln -sf /usr/bin/clang-15 /usr/local/bin/clang \
    && ln -sf /usr/bin/llvm-spirv-15 /usr/local/bin/llvm-spirv

# Kazarov builds Vulkan shaders for the Switch target with this pinned glslang release.
RUN git clone --depth 1 --branch ${GLSLANG_TAG} https://github.com/KhronosGroup/glslang.git /tmp/glslang \
    && cmake -S /tmp/glslang -B /tmp/glslang/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_OPT=OFF -DGLSLANG_TESTS=OFF -DBUILD_SHARED_LIBS=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/glslang/build --target install \
    && rm -rf /tmp/glslang

# NVK's compiler (NAK) is Rust: a pinned nightly with rust-src, since the Switch's std is built from it.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal --default-toolchain none \
    && rustup toolchain install ${RUST_NIGHTLY} --profile minimal --component rust-src \
    && rustup default ${RUST_NIGHTLY} \
    && LIBCLANG_PATH=/usr/lib/llvm-15/lib cargo install --locked bindgen-cli --version ${BINDGEN_VERSION} \
    && rm -rf "$CARGO_HOME/registry" "$CARGO_HOME/git"
ENV LIBCLANG_PATH=/usr/lib/llvm-15/lib

# Mesa: setup.sh writes the machine files and builds Rust's std for the Switch and the host tools;
# merge-vk.sh folds NVK and everything it links into one libvulkan_nouveau.a. Its scripts ask for
# a toolchain named plain "nightly", which rustup will not alias, so they are pointed at the pin;
# its bindgen wrapper runs /usr/bin/bindgen. The fork's subprojects/.gitignore leaves out
# subprojects/packagefiles (the Rust crates' Meson files), so they come from the 26.2.3 release
# it is based on.
ARG MESA_TARBALL_SHA256=1628058a8d2c0615975de5a15ab7bbb9638c50000b5bed9456ff423ea034a81f
# NVK's image layout library (nil) also needs cbindgen 0.28 or later, and bindgen runs rustfmt.
# mesa_clc looks for clang's OpenCL headers beside itself rather than in Debian's LLVM, so the host
# build bundles them into it.
ARG CBINDGEN_VERSION=0.29.4
# mesa_clc also needs SPIRV-Tools 2024.1 or later; Debian 12 has 2023.1.
ARG SPIRV_SDK_TAG=vulkan-sdk-1.4.363.0
RUN git clone --depth 1 --branch ${SPIRV_SDK_TAG} https://github.com/KhronosGroup/SPIRV-Headers.git /tmp/spirv-headers \
    && git clone --depth 1 --branch ${SPIRV_SDK_TAG} https://github.com/KhronosGroup/SPIRV-Tools.git /tmp/spirv-tools \
    && cmake -S /tmp/spirv-headers -B /tmp/spirv-headers/build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/spirv-headers/build --target install \
    && cmake -S /tmp/spirv-tools -B /tmp/spirv-tools/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local -DSPIRV-Headers_SOURCE_DIR=/tmp/spirv-headers \
        -DSPIRV_SKIP_TESTS=ON -DSPIRV_SKIP_EXECUTABLES=ON -DSPIRV_WERROR=OFF -DBUILD_SHARED_LIBS=ON \
    && cmake --build /tmp/spirv-tools/build --target install \
    && ldconfig \
    && rm -rf /tmp/spirv-headers /tmp/spirv-tools
RUN ln -sf "$CARGO_HOME/bin/bindgen" /usr/bin/bindgen \
    && rustup component add rustfmt --toolchain ${RUST_NIGHTLY} \
    && cargo install --locked cbindgen --version ${CBINDGEN_VERSION} \
    && rm -rf "$CARGO_HOME/registry" "$CARGO_HOME/git" \
    && git clone https://github.com/etonedemid/mesa-switch.git /tmp/mesa \
    && git -C /tmp/mesa checkout --detach ${MESA_REV} \
    && curl -sSfL -o /tmp/mesa.tar.xz https://archive.mesa3d.org/mesa-26.2.3.tar.xz \
    && echo "${MESA_TARBALL_SHA256}  /tmp/mesa.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/mesa.tar.xz -C /tmp/mesa/subprojects --strip-components=2 mesa-26.2.3/subprojects/packagefiles \
    && rm /tmp/mesa.tar.xz \
    && cd /tmp/mesa/switch \
    && sed -i "s/--toolchain nightly/--toolchain ${RUST_NIGHTLY}/; s/+nightly /+${RUST_NIGHTLY} /" setup.sh rust/build-sysroot.sh \
    && sed -i "s/-Dzstd=disabled$/-Dzstd=disabled -Dmesa-clc-bundle-headers=enabled/" build-host.sh \
    && grep -q mesa-clc-bundle-headers build-host.sh \
    && ./setup.sh \
    && ./configure-vk.sh \
    && ninja -C build-vk install \
    && ./merge-vk.sh \
    && mkdir -p ${SWITCH_PREFIX} \
    && cp -r stage-vk/lib stage-vk/include ${SWITCH_PREFIX}/ \
    && rm -rf /tmp/mesa

# SDL3 with its Vulkan support on. It builds against its own copy of the Vulkan headers and only
# records vulkan_nouveau for the application's link.
# patches/sdl-vulkan-window-without-egl.patch: the fork refuses every window until EGL is loaded,
# which SDL does only for OpenGL windows, so a Vulkan window could not be made at all.
COPY patches/sdl-vulkan-window-without-egl.patch /tmp/sdl-vulkan-window-without-egl.patch
RUN git clone https://github.com/etonedemid/SDL.git /tmp/sdl \
    && git -C /tmp/sdl checkout --detach ${SDL_REV} \
    && git -C /tmp/sdl apply --check /tmp/sdl-vulkan-window-without-egl.patch \
    && git -C /tmp/sdl apply /tmp/sdl-vulkan-window-without-egl.patch \
    && cmake -S /tmp/sdl -B /tmp/sdl/build -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE=${DEVKITPRO}/cmake/Switch.cmake -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=${SWITCH_PREFIX} -DCMAKE_PREFIX_PATH=${SWITCH_PREFIX} \
        -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF -DSDL_VULKAN=ON \
    && cmake --build /tmp/sdl/build --target install \
    && rm -rf /tmp/sdl

# The build runs as the invoking user so the mounted checkout keeps its ownership.
RUN chmod -R a+rX /opt/rust ${SWITCH_PREFIX}
