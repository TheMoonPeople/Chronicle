{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "pc",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "PLATFORM": "PC"
            }
        },
        {
            "name": "linux",
            "hidden": true,
            "inherits": "pc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "linux-x64",
            "displayName": "Linux x86-64, Debug (clang++-20)",
            "inherits": "linux",
            "binaryDir": "${sourceDir}/port/build/pc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-x64-release",
            "displayName": "Linux x86-64, Release (clang++-20)",
            "inherits": "linux",
            "binaryDir": "${sourceDir}/port/build/pc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos",
            "hidden": true,
            "inherits": "pc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
                "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/llvm;/opt/homebrew/opt/sdl3;/opt/homebrew/opt/vulkan-headers;/opt/homebrew/opt/vulkan-loader;/opt/homebrew/opt/glslang",
                "CMAKE_CXX_FLAGS": "-D_LIBCPP_DISABLE_AVAILABILITY",
                "CMAKE_EXE_LINKER_FLAGS": "-L/opt/homebrew/opt/llvm/lib/c++ -L/opt/homebrew/opt/llvm/lib/unwind -lunwind"
            }
        },
        {
            "name": "macos-arm64",
            "displayName": "macOS arm64, Debug (Homebrew LLVM)",
            "inherits": "macos",
            "binaryDir": "${sourceDir}/port/build/macos-arm64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-arm64-release",
            "displayName": "macOS arm64, Release (Homebrew LLVM)",
            "inherits": "macos",
            "binaryDir": "${sourceDir}/port/build/macos-arm64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "switch",
            "displayName": "Nintendo Switch homebrew (devkitA64)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/port/build/switch",
            "toolchainFile": "$env{DEVKITPRO}/cmake/Switch.cmake",
            "cacheVariables": {
                "PLATFORM": "SWITCH",
                "CMAKE_BUILD_TYPE": "Release",
                "DC_BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-x64",
            "configurePreset": "linux-x64"
        },
        {
            "name": "linux-x64-release",
            "configurePreset": "linux-x64-release"
        },
        {
            "name": "macos-arm64",
            "configurePreset": "macos-arm64"
        },
        {
            "name": "macos-arm64-release",
            "configurePreset": "macos-arm64-release"
        },
        {
            "name": "switch",
            "configurePreset": "switch"
        }
    ],
    "testPresets": [
        {
            "name": "test",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 4
            }
        },
        {
            "name": "linux-x64",
            "inherits": "test",
            "configurePreset": "linux-x64"
        },
        {
            "name": "linux-x64-release",
            "inherits": "test",
            "configurePreset": "linux-x64-release"
        },
        {
            "name": "macos-arm64",
            "inherits": "test",
            "configurePreset": "macos-arm64"
        },
        {
            "name": "macos-arm64-release",
            "inherits": "test",
            "configurePreset": "macos-arm64-release"
        }
    ]
}
